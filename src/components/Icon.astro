---
interface Props { name: 'linkedin' | 'github' | 'mail' | 'download' | 'pin' | 'arrow' | 'link' | 'arrow-up' | 'sun' | 'graduation' | 'award' | 'book' | 'check' | 'lightbulb' }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></>}
  {name === 'github' && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.200-1.500 6.200-6.800a5.300 5.300 0 0 0-1.400-3.700 4.900 4.900 0 0 0-.1-3.700s-1.100-.3-3.800 1.500a13.400 13.400 0 0 0-7 0C6.300 2.800 5.200 3.100 5.200 3.100a4.900 4.900 0 0 0-.1 3.700A5.300 5.300 0 0 0 3.700 10.500c0 5.300 3.200 6.500 6.200 6.800a3.400 3.400 0 0 0-.9 2.600V22" />}
  {name === 'mail' && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></>}
  {name === 'download' && <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></>}
  {name === 'arrow' && <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>}
  {name === 'arrow-up' && <><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></>}
  {name === 'link' && <><path d="M10 13a5 5 0 0 0 7.500.500l3-3a5 5 0 0 0-7-7l-1.700 1.700" /><path d="M14 11a5 5 0 0 0-7.500-.500l-3 3a5 5 0 0 0 7 7l1.700-1.700" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M2 12h2M20 12h2M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400" /></>}
  {name === 'graduation' && <><path d="M21.42 10.92a1 1 0 0 0-.02-1.84L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0z" /><path d="M22 10v6" /><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" /></>}
  {name === 'award' && <><circle cx="12" cy="8" r="6" /><path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11" /></>}
  {name === 'book' && <><path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></>}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'lightbulb' && <><path d="M15 14c.2-1 .7-1.700 1.500-2.500 1-.9 1.500-2.200 1.500-3.500A6 6 0 0 0 6 8c0 1 .2 2.200 1.500 3.500.7.700 1.300 1.500 1.500 2.500" /><path d="M9 18h6" /><path d="M10 22h4" /></>}
</svg>
